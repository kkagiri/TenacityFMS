flowchart LR
    %% FMS project dependency and runtime context diagram.
    %% Derived from frontend API clients and .NET ProjectReference entries.

    subgraph Frontend[Frontend clients]
        FmsFrontend["apps/fms.frontend\nReact main FMS web app"]
        FmsAdmin["apps/FMS.Admin\nReact admin/operator app"]
        FmsLanding["apps/FMS.Landing\nPublic landing app"]
        FmsMobile["apps/fms.mobile\nReact Native mobile app"]
    end

    subgraph ApiHosts[API and process hosts]
        WebClient["apps/FMS.WebClient\nMain .NET API host"]
        SalesApi["FMS.Sales/FMS.Sales.Api\nSales API host"]
        BackgroundHost["services/FMS.BackgroundServices\nBackground processing host"]
        TrackingHost["services/FMS.Devices.Tracking.Host\nTracking worker host"]
        PtsHost["services/FMS.PTS.WindowsService\nFueling/PTS Windows Service"]
    end

    subgraph CoreLayers[Main FMS clean architecture packages]
        Application["packages/FMS.Application\nCQRS, features, DTOs, services"]
        Domain["packages/FMS.Domain\nDomain entities and core models"]
        Persistence["packages/FMS.Persistence\nEF data access, GPSDataContext"]
        Infrastructure["packages/FMS.Infrastructure\nExternal integrations and infrastructure services"]
    end

    subgraph DevicePlatform[Device provider platform packages]
        DeviceAbstractions["packages/FMS.Devices.Abstractions\nProvider interfaces and canonical contracts"]
        DeviceCore["packages/FMS.Devices.Core\nProvider registry, routing, config repositories"]
        DeviceFueling["packages/FMS.Devices.Fueling\nFueling providers, PTS protocol, channels"]
        DeviceTracking["packages/FMS.Devices.Tracking\nTracking providers, GPS integrations, channels"]
    end

    subgraph SalesContext[Sales bounded context]
        SalesApplication["FMS.Sales/FMS.Sales.Application\nSales application layer"]
        SalesDomain["FMS.Sales/FMS.Sales.Domain\nSales domain layer"]
        SalesPersistence["FMS.Sales/FMS.Sales.Persistence\nSales persistence layer"]
    end

    subgraph ExternalSystems[External systems and data stores]
        MainDb[("MySQL / GPSDataContext\nFMS operational data")]
        Redis[("Redis\nCommands and messaging")]
        RabbitMq[("RabbitMQ\nTracking/event messaging")]
        SignalR["SignalR hubs\nLive web/mobile updates"]
        PtsDevices["PTS fueling devices\nPumps, probes, ATG"]
        TrackingVendors["Tracking vendors\nGPSGate, GPSWox, provider APIs"]
        SalesDb[("Sales database\nSales bounded context data")]
    end

    FmsFrontend -->|Axios API base from REACT_APP_* or /api| WebClient
