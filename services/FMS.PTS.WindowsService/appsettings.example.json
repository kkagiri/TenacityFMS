{
  "PTSService": {
    "WebSocket": {
      "ListenPort": 54098,
      "MaxConcurrentConnections": 100,
      "BufferSize": 65536,
      "ConnectionTimeout": "00:05:00",
      "Host": "YOUR_WEBSOCKET_HOST",
      "BasePath": "/ptsWebSocket"
    },
    "ConnectionStrings": {
      "FMSConnection": "REPLACED_BY_ENV_VAR",
      "RedisConnection": "REPLACED_BY_ENV_VAR"
    },
    "Device": {
      "AllowedDevices": [],
      "AutoReconnect": true,
      "ReconnectIntervalSeconds": 30,
      "HealthCheckIntervalSeconds": 60
    },
    "Logging": {
      "LogLevel": {
        "Default": "Information",
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      },
      "Security": {
        "RequireAuthentication": true,
        "ApiKey": "REPLACED_BY_ENV_VAR",
        "AllowedIPs": []
      },
      "Serilog": {
        "MinimumLevel": {
          "Default": "Information"
        }
      }
    }
  },
  "Jwt": {
    "Key": "REPLACED_BY_ENV_VAR",
    "Issuer": "REPLACED_BY_ENV_VAR",
    "Audience": "REPLACED_BY_ENV_VAR",
    "ExpiryInMinutes": 10080
  }
}
