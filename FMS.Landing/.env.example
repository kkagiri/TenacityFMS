# Tenacy FMS Landing — environment variables
# Copy to .env.local for local development (gitignored).

# Public Sales API base URL (plans, currencies, onboarding/contact/demo submissions)
VITE_SALES_API_URL=http://localhost:5101

# Authenticated app login URL (where the header "Sign in" button redirects)
VITE_APP_LOGIN_URL=http://localhost:3000/login

# Authenticated app home (where authenticated users see "Open app")
VITE_APP_HOME_URL=http://localhost:3000/home

# Marketing site analytics — leave empty to disable
VITE_ANALYTICS_KEY=
