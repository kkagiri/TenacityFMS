{
  "DeploymentSettings": {
    "Environment": "production",
    "ReactDeploymentPath": "C:\\inetpub\\wwwroot\\tenacyFMS\\reactApp",
    "WebApiDeploymentPath": "C:\\inetpub\\wwwroot\\tenacyFMS\\webAPI",
    "IisSiteName": "ReactApp",
    "BackendSiteName": "apitenacyfms",
    "IisAppPool": "apitenacyfms",
    "HealthCheckUrl": "http://localhost:7009/api/health",
    "HealthCheckRetries": 5,
    "HealthCheckRetryDelay": 10
  },
  "BackupSettings": {
    "BackupDirectory": "C:\\backups\\tenacyFMS",
    "MaxBackupsToKeep": 5
  },
  "BuildSettings": {
    "BuildFrontendOnServer": false,
    "BuildBackendOnServer": false,
    "FrontendBuildPath": "..\\..\\frontend\\build",
    "BackendBuildPath": "..\\..\\backend\\bin\\Release\\net8.0\\publish"
  },
  "EmailSettings": {
    "SmtpServer": "mail.example.com",
    "SmtpPort": 25,
    "UseSsl": false,
    "Username": "notifications@example.com",
    "Password": "YourPasswordHere",
    "From": "notifications@example.com",
    "To": "admin@example.com",
    "CcList": "team@example.com,manager@example.com"
  },
  "LogSettings": {
    "FilePath": "./logs/deployment_log_{timestamp}.txt",
    "MinimumLevel": "Information"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "./logs/deployment_log_.txt",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"]
  }
}
