# Example Environment Configuration
# Copy this file to .env and replace the placeholder values with your actual configuration
# DO NOT commit .env file to version control!

# Environment
NODE_ENV=production
REACT_APP_FMS_ENVIRONMENT=production
REACT_APP_ENVIRONMENT=production

# API Configuration - Intranet (Private Network - PRIORITIZED)
# This is tried first for users on the same network (faster)
# IMPORTANT: Must include /api suffix for proper routing
REACT_APP_PRIVATE_FMS_API_URL=http://YOUR_PRIVATE_IP/api

# API Configuration - Public IP (Internet Access - FALLBACK)
# This is used when intranet is not reachable (external users)
REACT_APP_PUBLIC_FMS_API_URL=http://YOUR_PUBLIC_IP/api

# Generic API URLs (for backward compatibility)
REACT_APP_API_URL=http://YOUR_PRIVATE_IP/api
REACT_APP_FMS_API_URL=http://YOUR_PRIVATE_IP/api
REACT_APP_FMS_API_URL_DEV=http://YOUR_DEV_IP/api
REACT_APP_FMS_API_URL_PROD=http://YOUR_PROD_IP/api

# SignalR Configuration
# No explicit URL - uses same auto-detection as API (intranet → public fallback)
# SignalR will automatically use the resolved API base URL from axiosInstance

# Local Development Flag
REACT_APP_IS_LOCAL_DEV=false

# INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Replace all YOUR_* placeholders with actual values
# 3. Never commit .env file to git
# 4. For production, use actual server IPs
# 5. For development, use localhost or dev server IPs
