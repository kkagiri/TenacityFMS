{
  "name": "tenacity-fms",
  "version": "1.0.0",
  "description": "Tenacity FMS Development Scripts",
  "scripts": {
    "start:backend": "cd apps/FMS.WebClient && dotnet run",
    "start:frontend": "cd apps/fms.frontend && npm start",
    "start:admin": "cd apps/FMS.Admin && npm run dev",
    "start:mobile": "cd apps/fms.mobile && npm start",
    "build:admin": "cd apps/FMS.Admin && npm run build",
    "preview:admin": "cd apps/FMS.Admin && npm run preview",
    "start:web": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run start:backend\" \"npm run start:frontend\"",
    "start:all": "concurrently -n \"backend,frontend,admin,mobile\" -c \"blue,green,cyan,yellow\" \"npm run start:backend\" \"npm run start:frontend\" \"npm run start:admin\" \"npm run start:mobile\"",
    "start:backend-frontend": "npm run start:web",
    "start:backend-mobile": "concurrently -n \"backend,mobile\" -c \"blue,yellow\" \"npm run start:backend\" \"npm run start:mobile\"",
    "start:frontend-mobile": "concurrently -n \"frontend,mobile\" -c \"green,yellow\" \"npm run start:frontend\" \"npm run start:mobile\""
  },
  "dependencies": {
    "devextreme": "22.2.5",
    "devextreme-react": "22.2.5",
    "@microsoft/signalr": "^8.0.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}