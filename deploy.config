# IIS Configuration
IIS_SITE_NAME="ReactApp"                   # Frontend site name
IIS_APP_POOL="apihyoungfms"                # App pool (shared between frontend and backend)
BACKEND_SITE_NAME="apihyoungfms"           # Backend site name (different from frontend)
# No separate BACKEND_APP_POOL as both sites share the same pool

# Deployment Paths
REACT_BUILD_PATH="C:\\actions-runner\\_work\\Hyoung.FMS\\Hyoung.FMS\\fms.frontend\\build"
WEBAPI_BUILD_PATH="C:\\actions-runner\\_work\\Hyoung.FMS\\Hyoung.FMS\\FMS.WebClient\\publish"
REACT_DEPLOYMENT_PATH="C:\\inetpub\\wwwroot\\hyoungFMS\\reactApp"
WEBAPI_DEPLOYMENT_PATH="C:\\inetpub\\wwwroot\\hyoungFMS\\webAPI"

# Server Configuration
SERVER_IP="10.0.10.153"
SERVER_USER="administrator"

# Health Check Configuration
