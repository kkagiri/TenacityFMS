{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": ["FromLogContext", "WithMachineName"],
    "Properties": {
      "Application": "FMS.WebClient",
      "Environment": "Production"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] ({CorrelationId}) {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "C:/Logs/FMS.Webclient/app/app-log-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "shared": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] ({CorrelationId}) {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "C:/Logs/FMS.Webclient/errors/error-.log",
          "rollingInterval": "Day",
          "restrictedToMinimumLevel": "Error",
          "retainedFileCountLimit": 60,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] ({CorrelationId}) {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://10.0.10.153:7009"
      },
      "LocalHttp": {
        "Url": "http://localhost:7009"
      }
    }
  },
    "GPSGate": {
    "BaseUrl": "https://10.0.10.150/comGpsGate/api/v.1",
    "ApiKey": "your-api-key-here",
    "ApplicationId": "12"
  },

  "FeatureToggles": {
    "EnableNewReconciliationEngine": true,
    "EnableAdvancedLogging": false,
    "EnableDeviceActivityMonitoring": true,
    "EnableEmailNotifications": true
  }
}
