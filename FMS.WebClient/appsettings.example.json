{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Warning",
      "System": "Warning",
      "FMS.WebClient": "Debug",
      "Microsoft.AspNetCore.Authentication": "Information"
    },
    "MinimumLevel": "Information",
    "MaxFileSizeMB": 10,
    "RetainedFileCount": 31,
    "EnableVerboseDeviceLogging": false
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": ["FromLogContext", "WithMachineName"],
    "Properties": {
      "Application": "FMS.WebClient",
      "Environment": "Development"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] ({CorrelationId}) {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "C:/Logs/FMS.Webclient/app/app-log-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "shared": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] ({CorrelationId}) {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "C:/Logs/FMS.Webclient/errors/error-.log",
          "rollingInterval": "Day",
          "restrictedToMinimumLevel": "Error",
          "retainedFileCountLimit": 60,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] ({CorrelationId}) {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "SubLogger": [
      {
        "Filter": [
          {
            "Name": "ByIncludingOnly",
            "Args": { "expression": "Audit = true" }
          }
        ],
        "WriteTo": [
          {
            "Name": "File",
            "Args": {
              "path": "C:/Logs/FMS.Webclient/audit/audit-.log",
              "rollingInterval": "Day",
              "retainedFileCountLimit": 90,
              "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] ({CorrelationId}) {Message:lj}{NewLine}{Exception}"
            }
          }
        ]
      },
      {
        "Filter": [
          {
            "Name": "ByIncludingOnly",
            "Args": { "expression": "SlowQuery = true" }
          }
        ],
        "WriteTo": [
          {
            "Name": "File",
            "Args": {
              "path": "C:/Logs/FMS.Webclient/slow/slow-.log",
              "rollingInterval": "Day",
              "retainedFileCountLimit": 14,
              "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] ({CorrelationId}) {Message:lj}{NewLine}{Exception}"
            }
          }
        ]
      }
    ]
  },
  "DetailedErrors": true,
  "AllowedHosts": "*",
  "SecretKey": "YOUR_SECRET_KEY_HERE",
  "EndOfShiftTime": "18:59:59",
  "StartOfShiftTime": "06:00:00",
  "OpeningStockPriority": ["Sensor", "ClosingStock", "CurrentVolume"],
  "ClosingStockPriority": ["Sensor", "LastEntry", "CurrentVolume"],
  "ConnectionStrings": {
    "FMSConnection": "REPLACED_BY_ENV_VAR",
    "ATGConnection": "REPLACED_BY_ENV_VAR",
    "RedisConnection": "REPLACED_BY_ENV_VAR"
  },
  "JwtSettings": {
    "SecretKey": "REPLACED_BY_ENV_VAR",
    "Issuer": "REPLACED_BY_ENV_VAR",
    "Audience": "REPLACED_BY_ENV_VAR",
    "ExpireDays": 7
  },
  "AutomatedReconciliation": {
    "ExecutionIntervalMinutes": 15,
    "EnableNotifications": true,
    "DefaultThresholdLiters": 10.0,
    "MaxRetryAttempts": 3,
    "RetryDelayMinutes": 5,
    "EnableHealthMonitoring": true,
    "HealthCheckIntervalMinutes": 30
  },
  "EmailSettings": {
    "SmtpServer": "REPLACED_BY_ENV_VAR",
    "SmtpPort": 25,
    "UseSsl": false,
    "Username": "REPLACED_BY_ENV_VAR",
    "Password": "REPLACED_BY_ENV_VAR",
    "FromAddress": "REPLACED_BY_ENV_VAR",
    "FromDisplayName": "FMS Notifications",
    "TimeoutSeconds": 30,
    "MaxRetryAttempts": 3,
    "RetryDelaySeconds": 5
  },
  "NotificationSettings": {
    "DefaultSender": "FMS Reconciliation System",
    "EnableBackgroundService": true,
    "MaxRetryAttempts": 3,
    "RetryDelayMinutes": 5
  },
  "Redis": {
    "ConnectionString": "REPLACED_BY_ENV_VAR",
    "PolicyTriggerChannel": "fms:reconciliation:triggers"
  },
  "DeviceActivity": {
    "WebSocketTimeoutSeconds": 30,
    "HttpTimeoutSeconds": 60,
    "CheckIntervalSeconds": 10,
    "ConfigCacheDurationMinutes": 5,
    "WebSocketStartupStaleThresholdMinutes": 10,
    "HttpStartupStaleThresholdMinutes": 20,
    "CleanupTimeoutMultiplier": 2
  },
  "WorkSchedule": {
    "WorkStartTime": "06:00",
    "WorkEndTime": "22:00",
    "Timezone": "UTC"
  },
  "CommandExecution": {
    "CommandTimeoutSeconds": 15,
    "StaleConnectionThresholdMinutes": 5
  },
  "Maintenance": {
    "RedisCleanupIntervalMinutes": 5,
    "EnableAutomaticCleanup": true,
    "EnablePerformanceLogging": false
  },
  "TankStock": {
    "FutureRecordsPolicy": "WARN_RECALCULATE",
    "ShowDetailedWarnings": true,
    "MaxHistoricalDays": 0,
    "AllowOverride": true,
    "ShowRecordDetails": true
  },
  "GPSGate": {
    "BaseUrl": "REPLACED_BY_ENV_VAR",
    "ApiKey": "REPLACED_BY_ENV_VAR",
    "ApplicationId": "12"
  },
  "GPSGateUser": {
    "Username": "REPLACED_BY_ENV_VAR",
    "Password": "REPLACED_BY_ENV_VAR"
  },
  "FeatureToggles": {
    "EnableNewReconciliationEngine": true,
    "EnableAdvancedLogging": false,
    "EnableDeviceActivityMonitoring": true,
    "EnableEmailNotifications": true
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:7009"
      }
    }
  }
}
