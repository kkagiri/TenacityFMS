## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

## =============================================================================
## SECURITY: Environment and Configuration Files with Secrets
## These files contain sensitive information and must NEVER be committed
## =============================================================================

# Environment files - ALL variants
*.env
*.env.*
!*.env.example
fms.frontend/.env
fms.frontend/.env.local
fms.frontend/.env.*.local

#Ignore prototype files in documentation
documentation/notifications/prototype/
documentation/features/Task Management module/prototype/
documentation/features/TankStockOperationanddashboard/StockManagement/transactionpage/prototype/
.vscode/
scripts/
*.ps1
*.bat
Properties/launchSettings.json
logs/
#context files
context/
environment/

## =============================================================================
## SECURITY: Configuration files with credentials
## Use .example.json templates instead - these contain actual passwords!
## =============================================================================
FMS.WebClient/appsettings.json
FMS.WebClient/appsettings.Development.json
FMS.WebClient/appsettings.Production.json
FMS.Deployment/appsettings.json
FMS.Deployment/appsettings.development.json
FMS.Deployment/appsettings.production.json
FMS.PTS.WindowsService/appsettings.json
FMS.PTS.WindowsService/appsettings.Development.json
FMS.PTS.WindowsService/appsettings.production.json
FMS.Testing/appsettings.Testing.json

# Keep only example configuration files
!**/*appsettings.example.json
!**/appsettings.example.json

## =============================================================================
## SECURITY: Scripts with hardcoded credentials
## These setup scripts often contain database passwords and API keys
## =============================================================================
scripts/environment/setup-environment.ps1
scripts/environment/setup-environment.bat
scripts/environment/setup-pts-env.ps1
scripts/environment/setup-pts-env.bat
scripts/environment/setup-frontend-env.ps1

# Keep example/template scripts
!scripts/**/*.example.ps1
!scripts/**/*.template.ps1

## =============================================================================
## SECURITY: Additional sensitive files
## =============================================================================
# Certificates and keys
*.pfx
*.p12
*.key
*.pem
*.crt
!**/trusted-root.crt

# Connection strings files
**/connectionstrings.config
**/secrets.json
**/secrets.*.json

# Backup files that may contain sensitive data
*.bak
*.backup
*.old

#googleDrivers files

.tmp.driveupload/
.tmp.drivedownload/

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# Visual Studio 2015 cache/options directory
.vs/
# Uncomment if you have tasks that create the project's static files in wwwroot
#wwwroot/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUNIT
*.VisualState.xml
TestResult.xml

# Build Results of an ATL Project
[Dd]ebugPS/
[Rr]eleasePS/
dlldata.c

# DNX
project.lock.json
project.fragment.lock.json
artifacts/

*_i.c
*_p.c
*_i.h
*.ilk
*.meta
*.obj
*.pch
*.pdb
*.pgc
*.pgd
*.rsp
*.sbr
*.tlb
*.tli
*.tlh
