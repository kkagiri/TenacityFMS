# Production Environment Configuration
# Used when running: npm run build:prod (explicit production build)
# Production Server: 10.0.10.153 (Intranet) / 197.254.33.227 (Public IP)
# Last Updated: 2025-10-30
#
# Network Configuration:
# - Intranet users (same network): Connect to 10.0.10.153:7009
# - External users (internet): Connect to 197.254.33.227:7009
# - Auto-detection will try intranet first, then public IP

NODE_ENV=production
REACT_APP_FMS_ENVIRONMENT=production
REACT_APP_ENVIRONMENT=production

# API Configuration - Intranet (Private Network - PRIORITIZED)
# This is tried first for users on the same network (faster)
# IMPORTANT: Must include /api suffix for proper routing
REACT_APP_PRIVATE_FMS_API_URL=http://10.0.10.153:7009/api

# API Configuration - Public IP (Internet Access - FALLBACK)
# This is used when intranet is not reachable (external users)
REACT_APP_PUBLIC_FMS_API_URL=http://197.254.33.227:7009/api

# Generic API URL (fallback)
REACT_APP_API_URL=http://10.0.10.153:7009/api
REACT_APP_FMS_API_URL=http://10.0.10.153:7009/api

# SignalR Configuration
# IMPORTANT: WebSocket connections require direct connection to Kestrel (port 7009)
# Cannot go through IIS URL rewrite - must use explicit port
# NO /api suffix for SignalR - connects directly to hub endpoints
# Intranet users will use this, external users handled by fallback in code
REACT_APP_SIGNALR_URL=http://10.0.10.153:7009

# Local Development Flag
REACT_APP_IS_LOCAL_DEV=false
