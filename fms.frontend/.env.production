# Production Environment Configuration
# Production Server IP: 10.0.10.153 (Main Production)
# IIS URL Rewrite Setup: Port 80 forwards /api/* to localhost:7009/api/*

NODE_ENV=production

# API Configuration - Use relative URLs (IIS URL Rewrite handles forwarding)
# Browser requests go to http://10.0.10.153/api/* (port 80)
# IIS forwards to http://localhost:7009/api/* (backend)
REACT_APP_PRIVATE_FMS_API_URL=/api
REACT_APP_API_URL=/api
REACT_APP_FMS_API_URL=/api
REACT_APP_FMS_API_URL_PROD=/api
REACT_APP_PUBLIC_FMS_API_URL=/api

# SignalR Configuration - Use relative URL for same-origin
# Browser connects to http://10.0.10.153/hub/* (port 80)
# IIS forwards to http://localhost:7009/hub/* (backend)
REACT_APP_SIGNALR_URL=
