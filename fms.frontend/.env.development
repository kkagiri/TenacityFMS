# Development Environment Configuration
# Development Server: 10.0.11.90 (Local Dev Machine)
# Production Server: 10.0.10.153 (For testing against prod data)
# Last Updated: 2025-10-30

NODE_ENV=development
PORT=3000
REACT_APP_FMS_ENVIRONMENT=development
REACT_APP_ENVIRONMENT=development

# API Configuration - Points to PRODUCTION server for testing
# Change to 10.0.11.90 if you have local development backend running
# IMPORTANT: Must include /api suffix for proper routing
REACT_APP_PRIVATE_FMS_API_URL=http://10.0.10.153:7009/api
REACT_APP_PUBLIC_FMS_API_URL=http://105.160.12.217:7009/api
REACT_APP_API_URL=http://10.0.10.153:7009/api
REACT_APP_FMS_API_URL=http://10.0.10.153:7009/api

# SignalR Configuration
# Leave empty to auto-derive from API URL with network detection
# IMPORTANT: NO /api suffix for SignalR - connects directly to hub endpoints
REACT_APP_SIGNALR_URL=http://10.0.10.153:7009

# Local Development Flag (set to true when running backend locally)
REACT_APP_IS_LOCAL_DEV=false

# Development Features
REACT_APP_ENABLE_LOGGING=true
REACT_APP_LOG_LEVEL=debug

# GPSGate Integration
REACT_APP_GPSGATE_API_URL=http://your-gpsgate-server.com/api
REACT_APP_GPSGATE_API_KEY=your-api-key-here
REACT_APP_GPSGATE_POLLING_INTERVAL=5000